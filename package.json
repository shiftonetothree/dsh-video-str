{
  "name": "@commonworks/dsh-video-str",
  "version": "0.1.1",
  "description": "DSH 插件：让 Agent 直接读取视频网站的字幕（B站/腾讯/芒果/优酷等），支持扫码登录、抓取、检索、分页阅读与导出 SRT/VTT/TXT。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "subtitle",
    "srt",
    "vtt",
    "bilibili",
    "video"
  ],
  "homepage": "https://github.com/shiftonetothree/dsh-video-str#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiftonetothree/dsh-video-str.git"
  },
  "bugs": {
    "url": "https://github.com/shiftonetothree/dsh-video-str/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "qrcode-generator": "^1.4.4"
  },
  "scripts": {
    "test": "node --test test/"
  }
}
